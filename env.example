# thirdweb Configuration
VITE_THIRDWEB_CLIENT_ID=dc150592e8e792bd61f3fe56cc8de95e

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Contract Addresses
# Ethereum USDC (Official USDC contract - Centre.io)
VITE_ETHEREUM_USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# Polygon USDC (Bridged USDC)
VITE_POLYGON_USDC_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
# Base USDC (Native USDC)
VITE_BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Supported Chain IDs (Base is the primary chain)
VITE_BASE_CHAIN_ID=8453
VITE_ETHEREUM_CHAIN_ID=1
VITE_POLYGON_CHAIN_ID=137

# Default Chain
VITE_DEFAULT_CHAIN_ID=8453

# Social data: leave unset to use Supabase when configured, or set to "mock" to force the in-memory demo
# VITE_SOCIAL_SOURCE=mock

# Tipping: "mock" (default, no money moves) or "live" (not implemented yet)
# VITE_TIPPING_MODE=mock

# --- Server side (used by the `session` service / Edge Function, never sent to the browser) ---
# Service role key and JWT secret from `npx supabase status -o env` (local) or Project Settings > API (hosted)
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# Where the browser exchanges a thirdweb token for a Supabase token.
# Local compose: http://127.0.0.1:54330   Hosted Supabase: https://<project>.supabase.co/functions/v1/thirdweb-session
VITE_AUTH_EXCHANGE_URL=http://127.0.0.1:54330
