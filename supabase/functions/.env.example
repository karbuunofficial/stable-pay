# Copy to supabase/functions/.env for `supabase functions serve` (that file is gitignored).
# On a hosted project set these with `supabase secrets set`.

# Same client ID as VITE_THIRDWEB_CLIENT_ID. The function uses it to ask thirdweb whether a session token is valid.
THIRDWEB_CLIENT_ID=

# The project's JWT secret. Local default shown; hosted: Project Settings > API > JWT Secret (legacy HS256).
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Browser origin allowed to call the function (default: any). Set to your site's origin in production.
# ALLOWED_ORIGIN=https://stablepay.example.com
